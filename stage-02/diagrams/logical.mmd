erDiagram
  app_user {
    bigint id PK
    text login
    text full_name
    text password_hash
    boolean active
    timestamp_with_time_zone created_at
  }
  user_role {
    bigint user_id PK
    text role_code PK
  }
  app_role {
    text code PK
  }
  equipment_type {
    bigint id PK
    text name
    boolean archived
  }
  type_capability {
    bigint type_id PK
    bigint capability_id PK
  }
  capability {
    bigint id PK
    text name
  }
  equipment {
    bigint id PK
    bigint type_id FK
    text inventory_no
    text name
    jsonb characteristics
    boolean archived
    bigint schedule_revision
  }
  admission {
    bigint id PK
    bigint user_id FK
    bigint type_id FK
    tstzrange valid_during
    text basis
    bigint granted_by FK
    timestamp_with_time_zone revoked_at
    timestamp_with_time_zone created_at
  }
  booking {
    bigint id PK
    bigint user_id FK
    bigint equipment_id FK
    bigint capability_id FK
    tstzrange period
    text purpose
    text status
    timestamp_with_time_zone cancelled_at
    text cancel_reason
    timestamp_with_time_zone created_at
  }
  alternative {
    bigint id PK
    bigint booking_id FK
    bigint equipment_id FK
    tstzrange period
    smallint priority
    text state
    timestamp_with_time_zone created_at
  }
  fault_report {
    bigint id PK
    bigint equipment_id FK
    bigint reported_by FK
    text description
    timestamp_with_time_zone reported_at
    text state
  }
  unavailability {
    bigint id PK
    bigint equipment_id FK
    text kind
    tstzrange period
    text reason
    bigint fault_report_id FK
    bigint created_by FK
    text status
    bigint resolved_by FK
    timestamp_with_time_zone resolved_at
    timestamp_with_time_zone created_at
  }
  repair {
    bigint id PK
    bigint unavailability_id FK
    bigint performed_by FK
    text work_kind
    tstzrange period
    text result
  }
  use_session {
    bigint id PK
    bigint booking_id FK
    timestamp_with_time_zone started_at
    timestamp_with_time_zone ended_at
    text close_comment
  }
  notification {
    bigint id PK
    bigint user_id FK
    bigint booking_id FK
    text kind
    text message
    timestamp_with_time_zone created_at
    timestamp_with_time_zone read_at
  }
  audit_event {
    bigint id PK
    bigint actor_id FK
    text table_name
    jsonb record_key
    text action
    jsonb old_data
    jsonb new_data
    timestamp_with_time_zone occurred_at
    bigint transaction_id
  }
  conflict_event {
    bigint id PK
    bigint user_id FK
    bigint equipment_id FK
    tstzrange requested_period
    text error_code
    timestamp_with_time_zone occurred_at
  }
  app_user ||--o{ user_role : "user_id"
  app_role ||--o{ user_role : "role_code"
  equipment_type ||--o{ type_capability : "type_id"
  capability ||--o{ type_capability : "capability_id"
  equipment_type ||--o{ equipment : "type_id"
  app_user ||--o{ admission : "user_id"
  equipment_type ||--o{ admission : "type_id"
  app_user ||--o{ admission : "granted_by"
  app_user ||--o{ booking : "user_id"
  equipment ||--o{ booking : "equipment_id"
  capability ||--o{ booking : "capability_id"
  booking ||--o{ alternative : "booking_id"
  equipment ||--o{ alternative : "equipment_id"
  equipment ||--o{ fault_report : "equipment_id"
  app_user ||--o{ fault_report : "reported_by"
  equipment ||--o{ unavailability : "equipment_id"
  fault_report o|--o| unavailability : "fault_report_id"
  app_user ||--o{ unavailability : "created_by"
  app_user o|--o{ unavailability : "resolved_by"
  unavailability ||--o{ repair : "unavailability_id"
  app_user ||--o{ repair : "performed_by"
  booking ||--o| use_session : "booking_id"
  app_user ||--o{ notification : "user_id"
  booking o|--o{ notification : "booking_id"
