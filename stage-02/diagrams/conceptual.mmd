erDiagram
  app_user {
    int8 id
    text login
    text full_name
    text password_hash
    bool active
  }
  app_role {
    text code
  }
  equipment_type {
    int8 id
    text name
    bool archived
  }
  capability {
    int8 id
    text name
  }
  equipment {
    int8 id
    int8 type_id
    text inventory_no
    text name
    jsonb characteristics
  }
  admission {
    int8 id
    int8 user_id
    int8 type_id
    tstzrange valid_during
    text basis
  }
  booking {
    int8 id
    int8 user_id
    int8 equipment_id
    int8 capability_id
    tstzrange period
  }
  alternative {
    int8 id
    int8 booking_id
    int8 equipment_id
    tstzrange period
    int2 priority
  }
  fault_report {
    int8 id
    int8 equipment_id
    int8 reported_by
    text description
    timestamptz reported_at
  }
  unavailability {
    int8 id
    int8 equipment_id
    text kind
    tstzrange period
    text reason
  }
  repair {
    int8 id
    int8 unavailability_id
    int8 performed_by
    tstzrange period
    text result
  }
  use_session {
    int8 id
    int8 booking_id
    timestamptz started_at
    timestamptz ended_at
    text close_comment
  }
  notification {
    int8 id
    int8 user_id
    int8 booking_id
    text kind
    text message
  }
  audit_event {
    int8 id
    int8 actor_id
    text table_name
    jsonb record_key
    text action
  }
  conflict_event {
    int8 id
    int8 user_id
    int8 equipment_id
    tstzrange requested_period
    text error_code
  }
  equipment_type ||--o{ equipment : "type_id"
  app_user ||--o{ admission : "user_id"
  equipment_type ||--o{ admission : "type_id"
  app_user ||--o{ admission : "granted_by"
  app_user ||--o{ booking : "user_id"
  equipment ||--o{ booking : "equipment_id"
  capability ||--o{ booking : "capability_id"
  booking ||--o{ alternative : "booking_id"
  equipment ||--o{ alternative : "equipment_id"
  equipment ||--o{ fault_report : "equipment_id"
  app_user ||--o{ fault_report : "reported_by"
  equipment ||--o{ unavailability : "equipment_id"
  fault_report o|--o| unavailability : "fault_report_id"
  app_user ||--o{ unavailability : "created_by"
  app_user o|--o{ unavailability : "resolved_by"
  unavailability ||--o{ repair : "unavailability_id"
  app_user ||--o{ repair : "performed_by"
  booking ||--o| use_session : "booking_id"
  app_user ||--o{ notification : "user_id"
  booking o|--o{ notification : "booking_id"
  app_user o|--o{ audit_event : "actor_id"
  app_user ||--o{ conflict_event : "user_id"
  equipment ||--o{ conflict_event : "equipment_id"
  app_user }o--o{ app_role : "M:N роли"
  equipment_type }o--o{ capability : "M:N функции"
